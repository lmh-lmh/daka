<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网底图 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 定位（打卡点位置、轨迹） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 注意：这里【不声明】CAMERA 权限。
         官方 javadoc 明确写：targetSdk >= M 且声明了 CAMERA 但未授予时，
         调 ACTION_IMAGE_CAPTURE 会直接抛 SecurityException。 -->

    <!-- Android 9 及以下写公共相册需要；10+ 走 MediaStore 不需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 足迹记录用前台服务（带常驻通知）。Android 14 起必须声明 location 类型对应的权限，
         否则 startForeground 直接抛 SecurityException。
         注意：这里【不声明】ACCESS_BACKGROUND_LOCATION——前台服务本身就能在后台拿位置，
         申请"始终允许"只会多一道系统审核和一层用户心理门槛，没有必要。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daka">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SpotListActivity"
            android:exported="false" />

        <activity
            android:name=".SpotDetailActivity"
            android:exported="false" />

        <activity
            android:name=".SpotEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PhotoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Daka.Photo" />

        <activity
            android:name=".TrackActivity"
            android:exported="false" />

        <activity
            android:name=".TrackDayActivity"
            android:exported="false" />

        <activity
            android:name=".AchievementsActivity"
            android:exported="false" />

        <activity
            android:name=".RegionSpotsActivity"
            android:exported="false" />

        <!-- 足迹记录服务。foregroundServiceType 必须写 location，
             否则 Android 14 上 startForeground 会抛 SecurityException。 -->
        <service
            android:name=".core.track.TrackService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

    <!-- Android 11+ 包可见性：要查系统相机 App 必须声明这个 -->
    <queries>
        <!-- 分享到第三方导航：Android 11+ 不声明就查不到这些包 -->
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.tencent.map" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

</manifest>
