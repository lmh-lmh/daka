<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF12161C">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="28dp"
            android:orientation="vertical">

            <!-- 顶栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="编辑打卡点"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_primary_pill"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="保存"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 图标预览 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/preview"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="标记预览" />

                <TextView
                    android:id="@+id/previewHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="地图上长这样"
                    android:textColor="#66FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView style="@style/DakaFieldLabel" android:text="名字" />

            <EditText
                android:id="@+id/etName"
                style="@style/DakaInput"
                android:hint="给这个点起个名字"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="60" />

            <TextView style="@style/DakaFieldLabel" android:text="分类" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView style="@style/DakaFieldLabel" android:text="备注" />

            <EditText
                android:id="@+id/etNote"
                style="@style/DakaInput"
                android:gravity="top"
                android:hint="当时发生了什么（可留空）"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:minLines="3" />

            <TextView style="@style/DakaFieldLabel" android:text="评分与收藏" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/starRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <CheckBox
                    android:id="@+id/cbFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FF8F00"
                    android:text="收藏"
                    android:textColor="#CCFFFFFF" />
            </LinearLayout>

            <TextView style="@style/DakaFieldLabel" android:text="标记形状" />

            <LinearLayout
                android:id="@+id/gridShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView style="@style/DakaFieldLabel" android:text="颜色" />

            <LinearLayout
                android:id="@+id/gridColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView style="@style/DakaFieldLabel" android:text="大小" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <SeekBar
                    android:id="@+id/seekSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="14"
                    android:progress="4" />

                <TextView
                    android:id="@+id/tvSize"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1.0×"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView style="@style/DakaFieldLabel" android:text="文字 / Emoji 标记（选了就不画形状）" />

            <LinearLayout
                android:id="@+id/gridEmoji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView style="@style/DakaFieldLabel" android:text="自定义图标（优先于上面全部）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/btnPickIcon"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center"
                    android:text="从相册选一张图"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnClearIcon"
                    android:layout_width="96dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center"
                    android:text="清除"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:text="删除这个打卡点"
                android:textColor="#FF6B6B"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
