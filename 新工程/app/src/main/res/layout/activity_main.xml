<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 右上角：缩放 + 定位 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnZoomIn"
            style="@style/DakaMapButton"
            android:text="＋" />

        <TextView
            android:id="@+id/btnZoomOut"
            style="@style/DakaMapButton"
            android:layout_marginTop="8dp"
            android:text="－" />

        <TextView
            android:id="@+id/btnLocate"
            style="@style/DakaMapButton"
            android:layout_marginTop="8dp"
            android:text="◎" />
    </LinearLayout>

    <!-- 左上角：菜单 -->
    <TextView
        android:id="@+id/btnMenu"
        style="@style/DakaMapButton"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:text="≡" />

    <!-- 面包屑：全国 › 江西省 › 宜春市，点一下回到全国 -->
    <TextView
        android:id="@+id/tvBreadcrumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_hint"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="全国"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 顶部提示条（影像到顶提示等） -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="68dp"
        android:background="@drawable/bg_hint"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 底部：打卡按钮 -->
    <TextView
        android:id="@+id/btnAddSpot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_primary_pill"
        android:paddingHorizontal="28dp"
        android:paddingVertical="13dp"
        android:text="在这里打卡"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- 底部坐标/状态条 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_hint"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

    <!-- 点击标记后从底部升起的照片卡片（阶段 1 只做最简版） -->
    <include layout="@layout/card_spot" />

    <!-- 侧边面板打开时的半透明遮罩，点它收起面板 -->
    <View
        android:id="@+id/panelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- 侧边地区选择列表（可开关） -->
    <include layout="@layout/panel_region_list" />

    <!-- 左侧工具栏：菜单 + 地区列表开关，竖排在左上角下方。
         为什么单独一组：原来只有左上角一个菜单按钮，再加一个会挤，
         改成竖排小按钮组更清楚。 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="62dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRegionPanel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_btn"
            android:gravity="center"
            android:text="▤"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

</FrameLayout>
