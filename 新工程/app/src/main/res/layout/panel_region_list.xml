<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/regionPanel"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#F20E1116"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- 标题行：标题 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="选择地区"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPanelClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#99FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 搜索框 -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_search"
        android:hint="搜索地区"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#66FFFFFF"
        android:textSize="13sp" />

    <!-- 导航行：左侧"返回上一级"，右侧"回到全国"，中间是当前路径。
         为什么做成两个独立按钮而不是一个「‹」：用户明确要"返回全国和上一级"两个动作，
         合成一个的话从区县退回全国要点三次，很容易点错。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnPanelBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_search"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="‹ 上一级"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPanelCrumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="全国"
            android:textColor="#8AFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPanelHome"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_search"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⌂ 全国"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRegion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- 空状态 -->
    <TextView
        android:id="@+id/tvPanelEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="没有匹配的地区"
        android:textColor="#66FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
